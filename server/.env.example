# Copy to .env for local dev (never commit the real .env — it's already gitignored).
# On the VPS these are set as real environment variables by the PM2 ecosystem
# file / systemd unit, not by a checked-in .env.

# Postgres connection string.
#   Local:  postgres://wca:wca@localhost:5432/wca_crm
#   Hosted: postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://wca:wca@localhost:5432/wca_crm

# Set to "disable" for a local/Docker Postgres with no TLS. Leave unset
# (or "require") for a remote/managed Postgres — pgdb.js then enables SSL
# automatically for any non-localhost DATABASE_URL.
# PGSSLMODE=disable

# Required in production — without it the server falls back to an insecure
# hardcoded dev secret. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on.
PORT=4000

# Restrict in production to your actual frontend origin, e.g. https://your-domain.com
CORS_ORIGIN=*

# Bootstrap admin account — only used the very first time the app boots
# against an empty `users` table. Leave unset for local dev (falls back to
# WCA_ADMIN / Admin@123 with a startup warning) — set both for anything
# that isn't a throwaway local instance. Has no effect once a user already
# exists; change your password via the app afterward, not by editing this.
# ADMIN_USERNAME=WCA_ADMIN
# ADMIN_PASSWORD=change-me-to-something-real

# Fictional demo companies/clients/policies/claims/RFQs seeded on first boot
# alongside the schema — on by default for local dev, set to "false" in
# production so real users don't see fake data.
# SEED_DEMO_DATA=false
